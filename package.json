{
  "name": "todo",
  "version": "0.3.0",
  "private": true,
  "bin": {
    "todo": "src/cli.ts"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "routes": "tsr generate",
    "format": "oxfmt",
    "verify": "tsr generate && oxfmt --check && effect-tsgo oxlint --type-aware && effect-tsgo tsc -p tsconfig.json && effect-tsgo tsrs -p tsconfig.json && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@commander-js/extra-typings": "15.0.0",
    "@fontsource-variable/geist": "5.3.0",
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@xstate/react": "6.1.0",
    "better-sqlite3": "13.0.3",
    "chrono-node": "2.10.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "commander": "15.0.0",
    "effect": "4.1.2",
    "lucide-react": "1.69.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "xstate": "5.33.3"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.3",
    "@effect/vitest": "4.1.2",
    "@tanstack/router-cli": "1.167.46",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint-plugin-no-comments": "1.2.1",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsrs": "0.22.0-ts7.1.0-beta",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=26"
  }
}
