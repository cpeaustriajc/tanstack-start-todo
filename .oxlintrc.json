{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "jsx-a11y",
    "promise",
    "node"
  ],
  "jsPlugins": ["eslint-plugin-no-comments"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "restriction": "error",
    "style": "error"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
    "respectEslintDisableDirectives": false
  },
  "ignorePatterns": ["src/routeTree.gen.ts"],
  "rules": {
    "no-comments/disallowComments": [
      "error",
      {
        "allow": ["/usr/bin/env node$"]
      }
    ],
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "react/react-in-jsx-scope": "off",
    "oxc/no-rest-spread-properties": "off",
    "eslint/new-cap": "off",
    "eslint/no-redeclare": "off",
    "react/jsx-filename-extension": [
      "error",
      {
        "extensions": [".tsx"]
      }
    ],
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
      }
    ],
    "typescript/promise-function-async": "off",
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "ignoreInferredTypes": true,
        "treatMethodsAsReadonly": true,
        "allow": [
          {
            "from": "package",
            "package": "react",
            "name": ["ReactNode", "SyntheticEvent"]
          },
          {
            "from": "package",
            "package": "effect",
            "name": ["Effect", "None", "Some", "Utc"]
          }
        ]
      }
    ],
    "eslint/sort-vars": "off",
    "eslint/no-duplicate-imports": [
      "error",
      {
        "allowSeparateTypeImports": true
      }
    ],
    "react/function-component-definition": [
      "error",
      {
        "namedComponents": "arrow-function",
        "unnamedComponents": "arrow-function"
      }
    ],
    "node/no-top-level-await": [
      "error",
      {
        "ignoreBin": true
      }
    ],
    "unicorn/no-array-method-this-argument": "off",
    "node/no-sync": [
      "error",
      {
        "ignores": ["runSync"]
      }
    ],
    "eslint/one-var": "off",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react",
            "importNames": ["useState", "useEffect", "useReducer"],
            "message": "Client state lives in the feature provider's useReducer."
          },
          {
            "name": "drizzle-orm/effect-sqlite-node",
            "message": "Only src/server/db opens the database."
          },
          {
            "name": "@effect/sql-sqlite-node",
            "message": "Only src/server/db opens the database."
          },
          {
            "name": "better-sqlite3",
            "message": "Only src/server/db opens the database."
          },
          {
            "name": "drizzle-orm/sqlite-core",
            "message": "Tables are declared only in src/server/*/*-table.ts."
          }
        ]
      }
    ],
    "no-restricted-properties": [
      "error",
      {
        "object": "Match",
        "property": "orElse",
        "message": "Match every case; a fallback hides a missing transition."
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "react/forbid-component-props": "off",
        "react/jsx-props-no-spreading": "off"
      }
    },
    {
      "files": ["src/routes/**"],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": ["src/features/*/*-model.ts"],
      "rules": {
        "typescript/no-generated-empty-object-type": "off"
      }
    },
    {
      "files": ["src/features/*/*-provider.tsx"],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": ["vite.config.ts", "drizzle.config.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["src/**/*.test.ts"],
      "plugins": ["vitest"],
      "rules": {}
    },
    {
      "files": ["src/**/*-error.ts"],
      "rules": {
        "unicorn/throw-new-error": "off"
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["useState", "useEffect", "useReducer"],
                "message": "Client state lives in the feature provider's useReducer."
              },
              {
                "name": "drizzle-orm/effect-sqlite-node",
                "message": "Only src/server/db opens the database."
              },
              {
                "name": "@effect/sql-sqlite-node",
                "message": "Only src/server/db opens the database."
              },
              {
                "name": "better-sqlite3",
                "message": "Only src/server/db opens the database."
              },
              {
                "name": "drizzle-orm/sqlite-core",
                "message": "Tables are declared only in src/server/*/*-table.ts."
              }
            ],
            "patterns": [
              {
                "regex": "^drizzle-orm(/|$)",
                "message": "Views read todos from the route loader, not from Drizzle."
              },
              {
                "regex": "^#/server/",
                "message": "Only the feature provider calls the server."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/routes/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["useState", "useEffect", "useReducer"],
                "message": "Client state lives in the feature provider's useReducer."
              },
              {
                "name": "drizzle-orm/effect-sqlite-node",
                "message": "Only src/server/db opens the database."
              },
              {
                "name": "@effect/sql-sqlite-node",
                "message": "Only src/server/db opens the database."
              },
              {
                "name": "better-sqlite3",
                "message": "Only src/server/db opens the database."
              },
              {
                "name": "drizzle-orm/sqlite-core",
                "message": "Tables are declared only in src/server/*/*-table.ts."
              }
            ],
            "patterns": [
              {
                "regex": "^drizzle-orm(/|$)",
                "message": "Views read todos from the route loader, not from Drizzle."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/*/*-model.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "Models, the server and the domain stay free of React."
              },
              {
                "name": "drizzle-orm/effect-sqlite-node",
                "message": "Only src/server/db opens the database."
              },
              {
                "name": "@effect/sql-sqlite-node",
                "message": "Only src/server/db opens the database."
              },
              {
                "name": "better-sqlite3",
                "message": "Only src/server/db opens the database."
              },
              {
                "name": "drizzle-orm/sqlite-core",
                "message": "Tables are declared only in src/server/*/*-table.ts."
              },
              {
                "name": "#/domain/todo.ts",
                "importNames": ["Todo", "TodoList"],
                "message": "Models hold UI state, never server data."
              }
            ],
            "patterns": [
              {
                "regex": "^drizzle-orm(/|$)",
                "message": "Views read todos from the route loader, not from Drizzle."
              },
              {
                "regex": "^#/server/",
                "message": "Only the feature provider calls the server."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/*/*-provider.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "drizzle-orm/effect-sqlite-node",
                "message": "Only src/server/db opens the database."
              },
              {
                "name": "@effect/sql-sqlite-node",
                "message": "Only src/server/db opens the database."
              },
              {
                "name": "better-sqlite3",
                "message": "Only src/server/db opens the database."
              },
              {
                "name": "drizzle-orm/sqlite-core",
                "message": "Tables are declared only in src/server/*/*-table.ts."
              }
            ],
            "patterns": [
              {
                "regex": "^drizzle-orm(/|$)",
                "message": "Views read todos from the route loader, not from Drizzle."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/server/**", "src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "Models, the server and the domain stay free of React."
              },
              {
                "name": "drizzle-orm/effect-sqlite-node",
                "message": "Only src/server/db opens the database."
              },
              {
                "name": "@effect/sql-sqlite-node",
                "message": "Only src/server/db opens the database."
              },
              {
                "name": "better-sqlite3",
                "message": "Only src/server/db opens the database."
              },
              {
                "name": "drizzle-orm/sqlite-core",
                "message": "Tables are declared only in src/server/*/*-table.ts."
              }
            ],
            "patterns": [
              {
                "regex": "^#/features/",
                "message": "The server and the domain never depend on features."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/server/db/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "Models, the server and the domain stay free of React."
              },
              {
                "name": "drizzle-orm/sqlite-core",
                "message": "Tables are declared only in src/server/*/*-table.ts."
              }
            ],
            "patterns": [
              {
                "regex": "^#/features/",
                "message": "The server and the domain never depend on features."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/server/*/*-table.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "Models, the server and the domain stay free of React."
              },
              {
                "name": "drizzle-orm/effect-sqlite-node",
                "message": "Only src/server/db opens the database."
              },
              {
                "name": "@effect/sql-sqlite-node",
                "message": "Only src/server/db opens the database."
              },
              {
                "name": "better-sqlite3",
                "message": "Only src/server/db opens the database."
              }
            ],
            "patterns": [
              {
                "regex": "^#/features/",
                "message": "The server and the domain never depend on features."
              }
            ]
          }
        ]
      }
    }
  ]
}
